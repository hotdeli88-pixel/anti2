# 개발 환경 기본값. 실제 배포에서는 반드시 덮어쓸 것.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql+asyncpg://saengibu:saengibu@localhost:5432/saengibu

# Session (반드시 32+ 문자의 무작위 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars-for-jwt
SESSION_COOKIE_NAME=saengibu_session
CSRF_COOKIE_NAME=csrf_token
# 개발 환경에서는 HTTPS 없이 테스트하므로 false, 프로덕션은 true
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict

# Google OAuth 2.0 클라이언트 ID (console.cloud.google.com 에서 발급)
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com

# 학교 이메일 도메인 화이트리스트 (콤마 구분, 비워두면 모든 도메인 허용)
# 예: sd.ms.kr,sddm.ms.kr
ALLOWED_EMAIL_DOMAINS=

# CORS (프록시 사용 시 비워둠, 별도 도메인 배포 시 설정)
CORS_ORIGINS=

# AI (기본: 외부 LLM 차단)
LLM_EXTERNAL_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-4-6

# 훈령 버전 태그
RULES_VERSION=2026-03
